# int/float/str/bool conversions and edge cases
print(int(3.99), int(-3.99), int("0x1F", 16) if False else int("31"))
print(float(3), float("2.5e2"))
print(abs(-5), abs(3.5), round(3.7), round(3.2), round(2.5))
print(divmod(7, 2), divmod(-7, 2))
print(7 // 2, -7 // 2, 7 % 3, -7 % 3, 7.5 % 2)
print(2 ** 10, 2 ** -1, 9 ** 0.5)
print(max([3, 1, 4]), min("cab"), sum([1.5, 2.5]))
print(chr(65), ord("A"), hex(255), oct(8), bin(5))
print(str([1, "a", (2, 3)]), repr("x\ny"))
print(len("hello"), len([1, 2]), len({"a": 1}), len((1, 2)))
print(list("abc"), tuple([1, 2]), set([1, 1, 2]))
print(sorted("cab"), sorted([3, 1, 2], reverse=True))
print(reversed([1, 2, 3]))
print("".join(reversed("abc")))
